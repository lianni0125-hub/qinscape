QINSCAPE_RUNTIME=/root/autodl-tmp/qinscape/runtime
QINSCAPE_OUTPUTS=/root/autodl-tmp/qinscape/outputs
QINSCAPE_MODELS=/root/autodl-tmp/qinscape/models
HF_HOME=/root/autodl-tmp/qinscape/models/huggingface
QINSCAPE_LLM_MODEL=Qwen/Qwen3-1.7B
QINSCAPE_USE_LLM_PLANNER=1
TEXT2MIDI_MODEL=amaai-lab/text2midi
TEXT2MIDI_REPO=./sources/Text2midi
SOUNDFONT_GUQIN=/root/autodl-tmp/qinscape/assets/guqin.sf2
SOUNDFONT_ENSEMBLE=/root/autodl-tmp/qinscape/assets/MuseScore_General.sf3
QINSCAPE_GUQIN_RENDERER=procedural
# Voice checkpoints have their own licences. Point this template at a voice you may use.
DIFFSINGER_COMMAND='python deploy/run_diffsinger.py --midi {midi} --lyrics {lyrics} --voice {voice} --output {output}'
# Add only voice IDs that have a tested, licensed package behind QINSCAPE_DIFFSINGER_RUNNER.
QINSCAPE_VOCAL_VOICES=
QINSCAPE_DIFFSINGER_RUNNER=
# SoulX-Singer command template. The adapter supplies an authorized reference
# audio path plus its exact transcript, language, singing MIDI and new lyrics.
QINSCAPE_SOULX_COMMAND='/root/autodl-tmp/qinscape/.venv-soulx/bin/python /root/autodl-tmp/qinscape/deploy/run_soulx.py --midi {midi} --lyrics {lyrics} --voice {voice} --language {language} --output {output}'
QINSCAPE_SOULX_REPO=/root/autodl-tmp/qinscape/sources/SoulX-Singer
QINSCAPE_SOULX_PYTHON=/root/autodl-tmp/qinscape/.venv-soulx/bin/python
QINSCAPE_VOICE_LIBRARY=/root/autodl-tmp/qinscape/runtime/voices
QINSCAPE_ALLOW_CPU_INFERENCE=0
QINSCAPE_PORT=6006
# 资源部署完成且对公提供服务时，可设为 0 关闭页面部署入口。
QINSCAPE_SETUP_ENABLED=1
QINSCAPE_UPDATE_ENABLED=1
QINSCAPE_UPDATE_REPO=lianni0125-hub/qinscape
QINSCAPE_UPDATE_CHANNEL=main
QINSCAPE_UPDATE_INTERVAL=1800
